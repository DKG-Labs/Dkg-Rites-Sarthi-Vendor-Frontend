{
  "version": 2,
  "headers": [
    {
      "source": "/(index.html|version.json|sleeper-vendor/index.html|railpad/index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sleeper-vendor|railpad)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/immsapi/:path*",
      "destination": "/api/imms-proxy?path=:path*"
    },
    {
      "source": "/sleeper-vendor/assets/:path*",
      "destination": "/sleeper-vendor/assets/:path*"
    },
    {
      "source": "/sleeper-vendor/:path*",
      "destination": "/sleeper-vendor/index.html"
    },
    {
      "source": "/railpad/assets/:path*",
      "destination": "/railpad/assets/:path*"
    },
    {
      "source": "/railpad/:path*",
      "destination": "/railpad/index.html"
    },
    {
      "source": "/((?!sleeper-vendor|railpad|api|immsapi).*)",
      "destination": "/index.html"
    }
  ]
}