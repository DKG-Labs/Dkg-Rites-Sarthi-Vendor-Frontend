{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/immsapi/authenticate",
      "dest": "https://ireps.gov.in/immsapi/authenticate"
    },
    {
      "src": "/immsapi/purchase/(.*)",
      "dest": "https://ireps.gov.in/immsapi/purchase/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/railpad/(.*)",
      "dest": "/railpad/$1"
    },
    {
      "src": "\/(.*)",
      "dest": "/index.html"
    }
  ]
}