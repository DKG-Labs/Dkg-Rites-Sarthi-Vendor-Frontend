{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/immsapi/:path*",
      "destination": "/api/imms-proxy?path=:path*"
    },
    {
      "source": "/railpad/(.*)",
      "destination": "/railpad/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}